<?xml version="1.0" encoding="utf-8"?>
<project>
  <meta title="Text Alignment" package="flighthq_ports.openfl.samples.textalignment" version="0.1.0" />
  <app main="Main" file="TextAlignment" />
  <window width="800" height="600" fps="60" background="0xa0a0a0" />
  <source path="src" />
  <haxelib name="lime" />
  <haxelib name="flight" />
  <!-- <haxeflag name="-dce" value="full" /> -->
  <!-- The shared corpus at repo-root assets/, mounted under the same relative ids ts/ uses. -->
  <assets path="../../assets/img" rename="img" include="*.png" embed="true" />
  <assets path="../../assets/fonts" rename="fonts" include="LiberationSerif-Regular.ttf" embed="true" />
  <assets path="../../assets/fonts" rename="fonts" include="nokiafc22.ttf" embed="true" />
</project>
