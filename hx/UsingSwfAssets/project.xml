<?xml version="1.0" encoding="utf-8"?>
<project>
  <meta title="Using SWF Assets" package="hq.flight.samples.usingswfassets" version="0.1.0" />
  <app main="Main" file="UsingSwfAssets" />
  <window width="800" height="600" fps="60" background="0xffffff" hardware="true" vsync="true" />
  <window hardware="false" if="cairo" />
  <source path="Source" />
  <include path="${haxelib:flight}" />
  <haxelib name="lime" />
  <haxeflag name="-dce" value="full" />
  <assets path="../../../assets/swf" rename="swf" include="*.swf" />
</project>
