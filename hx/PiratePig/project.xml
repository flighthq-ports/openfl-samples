  <assets path="../../assets/images" rename="images" include="background_tile.png|center_bottom.png|logo.png|game_bear.png|game_bunny_02.png|game_carrot.png|game_lemon.png|game_panda.png|game_piratePig.png" embed="true" />
  <assets path="../../assets/fonts" rename="fonts" include="FreebooterUpdated.ttf" embed="true" />
  <assets path="../../assets/sounds" rename="sounds" include="theme.ogg|sound3.ogg|sound4.ogg|sound5.ogg" embed="true" />
